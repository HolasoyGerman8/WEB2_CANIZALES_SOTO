<html lang="es">
    
    <head>
        <title>Pratica 1</title>
    </head>
<body>
        <table >
            <tr>
                <td><img id="img0" src="imgs/hxh1.jpg" width="150"></td>
                <td><img id="img1" src="imgs/hxh2.jpg" width="150"></td>
                <td><img id="img2" src="imgs/hxh3.jpg" width="150"></td>
            </tr>
            <tr>
                <td><img id="img3" src="imgs/hxh4.jpg" width="150"></td>
                <td><img id="img4" src="imgs/hxh5.jpg" width="150"></td>
                <td><img id="img5" src="imgs/hxh6.jpg" width="150"></td>
            </tr>
            <tr>
                <td><img id="img6" src="imgs/hxh7.jpg" width="150"></td>
                <td><img id="img7" src="imgs/hxh8.jpg" width="150"></td>
                <td><img id="img8" src="imgs/hxh9.jpg" width="150"></td>
            </tr>
        </table>

        <br>
        <button id="btnAlerta" onclick="revolverimg()">Revolver</button>

        <script>
            const img = [
                "imgs/hxh1.jpg",
                "imgs/hxh2.jpg",
                "imgs/hxh3.jpg",
                "imgs/hxh4.jpg",
                "imgs/hxh5.jpg",
                "imgs/hxh6.jpg",
                "imgs/hxh7.jpg",
                "imgs/hxh8.jpg",
                "imgs/hxh9.jpg"
            ];

            function revolverimg() {
               // alert("Imagenes revueltas!");
                let imagenesMezcladas = [...img]; //se crea arreglo extra

                for (let i = imagenesMezcladas.length - 1; i > 0; i--) {
                    let j = Math.floor(Math.random() * (i + 1));
                    [imagenesMezcladas[i], imagenesMezcladas[j]] = [imagenesMezcladas[j], imagenesMezcladas[i]];
                    //Intercambio de elementos del arreglo (cambia el que está en i por el que está en j)
                }

                for (let i = 0; i < imagenesMezcladas.length; i++) {
                    document.getElementById("img" + i).src = imagenesMezcladas[i];
                    //Busca cada elemento de la tabla en la etiqueta con el img+i y lo reemplaza por el elemento random de j
                }
                
            }
        </script>
        <footer><h1>187372 - Leonardo Soto Adame</h1></footer>
    </body>
    
</html>

